### CPU-dependent directories
CONTIKI_CPU_DIRS += .

### CPU-dependent source files
CONTIKI_CPU_SOURCEFILES += soc.c
CONTIKI_CPU_SOURCEFILES += system_stm32f4xx.c

CONTIKI_SOURCEFILES += $(CONTIKI_CPU_SOURCEFILES)

### CPU-specific include paths (using already-expanded CONTIKI_CPU from platform Makefile)
CFLAGS += -I$(CONTIKI_CPU)

### Include the device-specific Makefile (e.g., Makefile.f446re)
include $(CONTIKI_CPU)/Makefile.$(CPU_MODEL)

include $(CONTIKI)/$(CONTIKI_NG_CM4_DIR)/Makefile.cm4