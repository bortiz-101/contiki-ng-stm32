# Device-specific configuration for STM32F446RE

### Add variant directory to source search path
CONTIKI_CPU_DIRS += f446re

### Linker script - using full path to f446re variant directory
LDSCRIPT ?= $(CONTIKI_CPU)/f446re/stm32f446re.ld

### Startup code (assembly) - file will be found via vpath from CONTIKI_CPU_DIRS
CONTIKI_CPU_SOURCEFILES += startup_stm32f446xx.s

### MCU-specific compiler flags
CFLAGS += -DSTM32F446xx

# TODO: Add per-MCU include paths when needed
# CFLAGS += -I$(CONTIKI_CPU)/f446re


